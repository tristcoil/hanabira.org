#!/bin/bash
# Config variables for Hanabira services

# Ports
export NGINX_PORT="${NGINX_PORT:-8888}"
export FRONTEND_PORT="${FRONTEND_PORT:-3000}"
export EXPRESS_PORT="${EXPRESS_PORT:-8000}"
export FLASK_PORT="${FLASK_PORT:-5100}"
export DICTIONARY_PORT="${DICTIONARY_PORT:-5200}"
export MONGO_PORT="${MONGO_PORT:-27017}"

# Directories
export DATA_DIR="${DATA_DIR:-/tmp/mongodb}"
export LOG_DIR="${LOG_DIR:-/var/log/mongodb}"
export PID_DIR="${PID_DIR:-/tmp/hanabira}"

# Options
export ENABLE_AUTO_SEED="${ENABLE_AUTO_SEED:-true}"
export ENABLE_BUILD_CACHE="${ENABLE_BUILD_CACHE:-true}"
export ENABLE_SSL="${ENABLE_SSL:-false}"